import os
from enum import Enum

import numpy as np
from numpy.typing import NDArray

class Boundary(Enum):
    Periodic = ...
    Fixed = ...
    Shrinkwrap = ...
    ShrinkwrapWithMinimumValue = ...

class PositionType(Enum):
    Plain = ...
    Scaled = ...
    PlainUnwrapped = ...

class LammpsDump: ...

def read(filename: str | os.PathLike[str]) -> LammpsDump: ...
def write(filename: str | os.PathLike[str], lammps_dump: LammpsDump) -> None: ...
def create(
    position_frames: NDArray[np.float64],
    box_frames: NDArray[np.float64],
    tid_frames: NDArray[np.uint64],
    boundary: tuple[
        tuple[Boundary, Boundary], tuple[Boundary, Boundary], tuple[Boundary, Boundary]
    ],
    position_type: tuple[PositionType, PositionType, PositionType],
) -> LammpsDump: ...
def get_timesteps(lammps_dump: LammpsDump) -> NDArray[np.uint64]: ...
def get_atom_poses(lammps_dump: LammpsDump) -> NDArray[np.float64]: ...
def get_atom_velocities(lammps_dump: LammpsDump) -> NDArray[np.float64]: ...
